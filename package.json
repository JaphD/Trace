{
  "name": "jlcpcb-local-workbench",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/write-build-info.cjs",
    "local": "node scripts/launch-trace.cjs",
    "stop": "node scripts/launch-trace.cjs --stop",
    "smoke:release": "node scripts/smoke-release.cjs",
    "start": "node dist/server.cjs --production",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "format": "prettier --write src server.ts vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src server.ts vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^6.0.3",
    "recharts": "^3.8.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "express": {
      "qs": "6.16.2"
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2"
  }
}
